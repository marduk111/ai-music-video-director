# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Recommended for RTX 3050 6GB:
#   llama3.2:3b | qwen2.5:3b | phi3.5:3.8b | gemma2:2b | llama3.1:8b
OLLAMA_MODEL=llama3.2:3b

PORT=3001
NODE_ENV=development

# --- Generation tuning (proxy → Ollama) ---
# Context window (2048 if VRAM is tight, 4096 default)
OLLAMA_NUM_CTX=4096
# Max tokens generated per call
OLLAMA_NUM_PREDICT=2048
# Lower = more consistent JSON (0.4–0.7)
OLLAMA_TEMPERATURE=0.65
# Layers on GPU: 99 = all that fit; lower if 8B OOMs
OLLAMA_NUM_GPU=99
# Prompt batch size (256–512 safe on 6GB)
OLLAMA_NUM_BATCH=512

# Production only:
# ALLOWED_ORIGINS=https://yourdomain.com
